{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "src/renderer/src/env.d.ts",
    "src/renderer/src/**/*",
    "src/preload/*.d.ts",
    "src/shared/**/*"
  ],
"compilerOptions": {
  "composite": true,
  "outDir": "./node_modules/.tmp/tsconfig.web",
  "jsx": "react-jsx",
  "paths": { "@renderer/*": ["./src/renderer/src/*"] },
  "noImplicitAny": true
}
}