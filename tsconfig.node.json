{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json", // main + preload + vite config
  "include": [
    "electron.vite.config.*",
    "src/main/**/*",
    "src/preload/**/*",
    "src/shared/**/*"
  ],
"compilerOptions": {
  "composite": true,
  "outDir": "./node_modules/.tmp/tsconfig.node",
  "types": ["electron-vite/node", "node"],
  "allowJs": true,
  "checkJs": false,
  "noImplicitAny": true
}
}